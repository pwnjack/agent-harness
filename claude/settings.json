{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/harness/claude/statusline.sh"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(~/.config/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.local/share/calendars/**)",
      "Read(~/.local/share/vdirsyncer/**)"
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/harness/claude/hooks/advisor-reset.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/harness/claude/hooks/agent-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/harness/claude/hooks/pkill-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
