{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude/statusline.sh"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(~/.config/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.local/share/calendars/**)",
      "Read(~/.local/share/vdirsyncer/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "impeccable@impeccable": false,
    "superpowers@anthropic-plugin-directory": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.config/claude/hooks/agent-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
